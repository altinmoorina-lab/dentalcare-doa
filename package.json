{
  "name": "dentalcare-doa",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n api,app -c blue,green \"npm:server\" \"npm:start\"",
    "dev:tunnel": "concurrently --kill-others-on-fail -n api,app -c blue,green \"npm:server\" \"npm:start:tunnel\"",
    "start": "expo start --port 19471",
    "start:tunnel": "expo start --tunnel --port 19471",
    "web": "expo start --web --port 19471",
    "server": "node scripts/run-server.mjs start",
    "server:dev": "node scripts/run-server.mjs dev",
    "typecheck": "tsc --noEmit && npm --prefix server run typecheck",
    "test": "tsx --test src/lib/*.test.ts && npm --prefix server test",
    "postinstall": "node scripts/postinstall.mjs",
    "build:web": "expo export --platform web && node scripts/postbuild-web.mjs"
  },
  "private": true
}
